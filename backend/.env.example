# PsyPredict v2.0 — Backend Environment Configuration
# Copy this file to .env and fill in your values.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "groq" (default, for Hugging Face Spaces) or "ollama" (local development)
LLM_PROVIDER=groq

# ── Groq API (used when LLM_PROVIDER=groq) ───────────────────────────────────
# Get a free key at https://console.groq.com (no credit card required)
# Not required when using LLM_PROVIDER=ollama
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (used when LLM_PROVIDER=ollama) ────────────────────────────────────
# No API keys needed — just run: ollama serve && ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3
OLLAMA_TIMEOUT_S=120
OLLAMA_RETRIES=3
OLLAMA_RETRY_DELAY_S=2.0

# ── DistilBERT Text Emotion Model ────────────────────────────────────────────
DISTILBERT_MODEL=bhadresh-savani/distilbert-base-uncased-emotion

# ── Crisis Detection ─────────────────────────────────────────────────────────
CRISIS_THRESHOLD=0.65

# ── Multimodal Fusion Weights (must sum to ~1.0) ─────────────────────────────
TEXT_WEIGHT=0.65
FACE_WEIGHT=0.35

# ── Context Window ────────────────────────────────────────────────────────────
MAX_CONTEXT_TURNS=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=30/minute

# ── Input Limits ──────────────────────────────────────────────────────────────
MAX_INPUT_CHARS=2000

# ── Frontend URL (for reference) ─────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:7860

# ── Deprecated (no longer used - kept for reference) ─────────────────────────
# GOOGLE_API_KEY=your_key_here

# ── Patient Memory — Adaptive Learning ───────────────────────────────────────
# Backend: "sqlite" (local, default, zero-config) or "supabase" (cloud)
PATIENT_MEMORY_BACKEND=sqlite
# Only needed if using Supabase backend:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key
# SQLITE_DB_PATH=  (auto-detected if empty)
PATIENT_HISTORY_MAX_SESSIONS=20
